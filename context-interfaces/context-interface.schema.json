{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "graph-shape"
    },
    "version": {
      "type": "number",
      "const": 3
    },
    "consumption": {
      "type": "string",
      "enum": [
        "source-linked",
        "self-contained"
      ]
    },
    "kinds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          }
        },
        "required": [
          "id",
          "label",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          },
          "contains": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
            }
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "contains",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    }
  },
  "required": [
    "kind",
    "version",
    "kinds",
    "relationships",
    "outputs",
    "entrypoint"
  ],
  "additionalProperties": false
}
