{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/interf-labs/compiler/context-protocol-v1.1/context-interfaces/graph-local.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "interf-graph-source-mapping"
    },
    "version": {
      "type": "number",
      "const": 2
    },
    "revision": {
      "type": "object",
      "properties": {
        "graph_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "graph_id",
        "revision_id",
        "manifest_digest"
      ],
      "additionalProperties": false
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-[a-f0-9]{16,64}$"
          },
          "expected_local_source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^src-[a-f0-9]{16,64}$"
                  },
                  "incarnation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "source_id",
                  "incarnation_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "local-folder"
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "kind",
                      "locator"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "agent-location"
                      },
                      "type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "scope": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "kind",
                      "locator"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "local_source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "source_id": {
                    "type": "string",
                    "pattern": "^src-[a-f0-9]{16,64}$"
                  },
                  "incarnation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "source_id",
                  "incarnation_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_id",
          "expected_local_source",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "requirements_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-[a-f0-9]{16,64}$"
          },
          "inventory_id": {
            "type": "string",
            "minLength": 1
          },
          "inventory_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "requirements_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "target_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "observed_at": {
            "type": "string"
          },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "type": "string",
                    "const": "read"
                  },
                  "content_hash": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "outcome",
                  "content_hash"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "missing",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "outcome"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "source_id",
          "inventory_id",
          "inventory_digest",
          "file_id",
          "requirements_digest",
          "target_digest",
          "observed_at",
          "result"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "version",
    "revision",
    "entries",
    "requirements_digest",
    "checks"
  ],
  "additionalProperties": false
}
